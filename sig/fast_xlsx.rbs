module FastXlsx
  VERSION: String

  class Error < StandardError
  end

  interface _Reader
    def read: () -> String
  end

  type cell = Numeric | String | Time | Date | Formula | URL | RichString | bool | nil | _ToS

  class RichString
    attr_reader segments: Array[[String, Format?]]
    def initialize: (*(_ToS | [_ToS, Format?]) parts) -> void
  end

  class Formula
    attr_reader expression: String
    def self.new: (_ToS expression) -> Formula
  end

  class URL
    attr_reader url: String
    attr_reader text: String?
    def self.new: (_ToS url, ?text: _ToS?) -> URL
  end

  class Workbook
    MEMORY_MODES: Array[Symbol]
    def self.new: (?memory: :standard | :constant | :low) -> Workbook
    def add_worksheet: (?String? name) -> Worksheet
    def worksheets: () -> Array[Worksheet]
    def worksheet: (String name) -> Worksheet?
    def properties: (?title: String, ?subject: String, ?author: String, ?manager: String,
                     ?company: String, ?category: String, ?keywords: String,
                     ?comments: String, ?status: String) -> self
    def to_xlsx: () -> String
    def save: (String | _ToPath path) -> void
  end

  class Format
    type color = String | Integer
    type border = :thin | :medium | :thick | :dashed | :dotted | :double | :hair

    type underline = bool | :single | :double | :single_accounting | :double_accounting

    def self.new: (?bold: bool, ?italic: bool, ?underline: underline, ?strikeout: bool, ?text_wrap: bool,
                   ?shrink: bool, ?locked: bool, ?hidden: bool, ?num_format: String, ?font_size: Numeric, ?font_name: String,
                   ?font_color: color, ?bg_color: color, ?font_script: :superscript | :subscript,
                   ?align: :left | :center | :right, ?valign: :top | :center | :bottom,
                   ?rotation: Integer, ?indent: Integer,
                   ?border: border, ?border_left: border, ?border_right: border,
                   ?border_top: border, ?border_bottom: border, ?border_color: color) -> Format
  end

  class Worksheet
    def write: (Integer row, Integer col, cell value, ?Format? format) -> self
    def append: (Array[cell] values, ?format: Format? | Array[Format?]) -> self
    def <<: (Array[cell] row) -> self
    def concat: (Array[Array[cell]] rows) -> self
    def column_width: (Integer | Range[Integer] columns, Numeric width) -> self
    def column_format: (Integer | Range[Integer] columns, Format format) -> self
    def autofit: () -> self
    def autofilter: (Integer first_row, Integer first_col, Integer last_row, Integer last_col) -> self
    def freeze_panes: (Integer row, Integer col) -> self
    def row_height: (Integer row, Numeric height) -> self
    def page_breaks: (Array[Integer] rows) -> self
    def vertical_page_breaks: (Array[Integer] cols) -> self
    def page_header: (String text, ?margin: Numeric?) -> self
    def page_footer: (String text, ?margin: Numeric?) -> self
    def margins: (?left: Numeric?, ?right: Numeric?, ?top: Numeric?, ?bottom: Numeric?,
                  ?header: Numeric?, ?footer: Numeric?) -> self
    type protect_action = :format_cells | :format_columns | :format_rows | :insert_columns | :insert_rows
                        | :insert_links | :delete_columns | :delete_rows | :sort | :use_autofilter
                        | :use_pivot_tables | :edit_scenarios | :edit_objects
    def protect: (?password: String?, ?allow: Array[protect_action]) -> self
    def merge_range: (Integer first_row, Integer first_col, Integer last_row, Integer last_col, cell value, ?Format? format) -> self
    def conditional_format: (Integer first_row, Integer first_col, Integer last_row, Integer last_col,
                             type: :cell | :text | :formula | :data_bar | :color_scale,
                             ?criteria: Symbol, ?value: Numeric | String | Array[Numeric | String],
                             ?format: Format, ?colors: 2 | 3) -> self
    def data_validation: (Integer first_row, Integer first_col, Integer last_row, Integer last_col,
                          type: :list | :whole_number | :decimal | :text_length,
                          ?criteria: Symbol, ?value: Numeric | String | Array[Numeric | String],
                          ?input_title: String, ?input_message: String,
                          ?error_title: String, ?error_message: String) -> self
    def write_comment: (Integer row, Integer col, String text, ?author: String?) -> self
    def insert_image: (Integer row, Integer col, String | _Reader source, ?scale: Numeric, ?width: Numeric, ?height: Numeric,
                       ?x_offset: Integer, ?y_offset: Integer, ?alt_text: String) -> self
    type chart_series = { values: String, ?categories: String, ?name: String }

    def insert_chart: (Integer row, Integer col, type: Symbol, series: Array[chart_series],
                       ?title: String, ?x_axis: String, ?y_axis: String,
                       ?width: Integer, ?height: Integer) -> self
    type table_column = String | { header: String, ?total: Symbol, ?total_label: String, ?format: Format }

    def add_table: (Integer first_row, Integer first_col, Integer last_row, Integer last_col,
                    ?columns: Array[table_column], ?style: Symbol, ?name: String,
                    ?total_row: bool, ?banded_rows: bool, ?autofilter: bool) -> self
    def name: () -> String
    def next_row: () -> Integer
  end
end
